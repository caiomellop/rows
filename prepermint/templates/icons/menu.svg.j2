{# lucide-animated (github.com/pqoqubbw/icons, MIT). Parts with .icon-anim draw in on hover (static/src/app.css). #}
<svg aria-hidden="true" class="icon {{ cls|default('') }}" width="{{ size|default(18) }}" height="{{ size|default(18) }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke|default(1.6) }}" stroke-linecap="round" stroke-linejoin="round">
  <line x1="4" y1="6" x2="20" y2="6" class="icon-anim" pathLength="1" />
  <line x1="4" y1="12" x2="20" y2="12" class="icon-anim" pathLength="1" />
  <line x1="4" y1="18" x2="20" y2="18" class="icon-anim" pathLength="1" />
</svg>
