  <rect x="3" y="3" width="18" height="7" rx="1" class="icon-anim" pathLength="1" />
  <rect x="3" y="14" width="7" height="7" rx="1" class="icon-anim" pathLength="1" />
  <rect x="14" y="14" width="7" height="7" rx="1" class="icon-anim" pathLength="1" />
</svg>
