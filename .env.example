# --- Required (local .env.local AND Vercel Environment Variables) ---

# 1) Supabase Postgres URI (Transaction pooler, port 6543)
#    Vercel: use the same DATABASE_URL you already set there.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# 2) Auth.js session secret — NOT from GitHub. Generate:
#    openssl rand -base64 32
AUTH_SECRET=

# 3–4) GitHub OAuth App → https://github.com/settings/developers
#    Callback: {NEXT_PUBLIC_APP_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# 5) Public app URL (local or Vercel preview/prod origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: same as NEXT_PUBLIC_APP_URL if OAuth host detection fails
# AUTH_URL=http://localhost:3000
