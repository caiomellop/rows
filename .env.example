# --- Required (local .env.local AND Vercel Environment Variables) ---

# 1) Supabase Postgres URI — copy it from Supabase → Connect → "Transaction pooler"
#    (port 6543). Do NOT use the "Direct connection" host db.<ref>.supabase.co:
#    it is IPv6-only and Vercel cannot reach it. The user must be
#    postgres.<PROJECT_REF> and the host prefix (aws-0 / aws-1 …) must match
#    exactly what the dashboard shows, otherwise you get "Tenant or user not found".
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres

# 2) Session cookie signing key: openssl rand -base64 32
AUTH_SECRET=

# 3) Email login links, sent through Resend (https://resend.com).
#    EMAIL_FROM must be a sender on a domain verified in Resend (SPF, DKIM, DMARC).
#    Without RESEND_API_KEY, local dev prints the link in the server log;
#    production cannot send and nobody can log in.
RESEND_API_KEY=
EMAIL_FROM=Prepermint <noreply@prepermint.com>

# 4) The two hosts. The site serves the landing and pricing; the app serves
#    sign-in, chat and the dashboard. Both domains point at this same Vercel
#    project. Locally, set only APP_URL to http://localhost:8000 and everything
#    is served from one origin. (The old names NEXT_PUBLIC_SITE_URL and
#    NEXT_PUBLIC_APP_URL are still read, so an existing Vercel project keeps working.)
SITE_URL=https://prepermint.com
APP_URL=https://app.prepermint.com

# 5) Claude API key for AI features (summary, resume import, CV assistant).
#    Optional: without it, AI buttons are hidden and everything can be written by hand.
ANTHROPIC_KEYS=

# 6) Voice interview prototype (CAI-36). Local runs and protected preview deployments only:
#    never set PROTOTYPE_ENABLED in production. The page has no login, so anyone who can open it
#    spends the API credits below. Leave it empty (off) everywhere else.
PROTOTYPE_ENABLED=
#    Deepgram key for speech recognition and the interviewer's voice (console.deepgram.com).
#    The server uses it to mint short-lived tokens for the browser, which needs a key with at least
#    the Member role. It holds one key; if several are listed with commas, the first is used.
DEEPGRAM_API_KEYS=
#    The interviewer's voice is chosen on the page, and it also sets the interview language. The voices,
#    with their language, speed and expressivity, are set in prepermint/features/interview/languages.py
#    (and its browser copy web/interview/languages.ts), so there is no variable for them.

# 7) Reading a job posting from a link (CAI-87, docs/adr/0002). Apify API token: console.apify.com →
#    Settings → API & integrations. Only the link is sent to Apify. Optional: without it, pasting a
#    link shows a message and pasting the text of the posting keeps working.
APIFY_TOKEN=

# 8) "production" makes the session cookie Secure and makes email sending required. Vercel sets VERCEL=1,
#    which counts as production too, so this is only needed elsewhere. Leave it empty locally.
APP_ENV=

# 9) Python app (CAI-99, docs/adr/0003). Opens the /_diag routes that check the database, streaming and
#    background tasks on the Python test deployment. Any long random string (openssl rand -base64 32), sent as
#    "Authorization: Bearer <token>". Leave it empty everywhere else: the routes then answer 404.
DIAGNOSTICS_TOKEN=
