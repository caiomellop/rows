# Supabase Postgres connection string
# Dashboard → Project Settings → Database → Connection string (URI)
# Prefer the Transaction pooler (port 6543) for serverless / Next.js.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth App (https://github.com/settings/developers)
# Authorization callback URL: {NEXT_PUBLIC_APP_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Public app origin (local: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Auth.js also reads AUTH_URL. Set it to the same value as NEXT_PUBLIC_APP_URL
# if callbacks mis-resolve the host (especially behind proxies).
# AUTH_URL=http://localhost:3000
