# --- Required (local .env.local AND Vercel Environment Variables) ---

# 1) Supabase Postgres URI (Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# 2–3) GitHub OAuth App → https://github.com/settings/developers
#    Homepage URL: https://rows.so
#    Authorization callback URL: https://rows.so/auth
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# 4) Public app URL
NEXT_PUBLIC_APP_URL=https://rows.so
# AUTH_URL=https://rows.so

# 5) Session signing secret (at least 32 random bytes): openssl rand -base64 32
#    Keep it different from AUTH_GITHUB_SECRET.
SESSION_SECRET=
