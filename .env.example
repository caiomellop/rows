# --- Required (local .env.local AND Vercel Environment Variables) ---

# 1) Supabase Postgres URI — copy it from Supabase → Connect → "Transaction pooler"
#    (port 6543). Do NOT use the "Direct connection" host db.<ref>.supabase.co:
#    it is IPv6-only and Vercel cannot reach it. The user must be
#    postgres.<PROJECT_REF> and the host prefix (aws-0 / aws-1 …) must match
#    exactly what the dashboard shows, otherwise you get "Tenant or user not found".
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres

# 2) Session cookie signing key: openssl rand -base64 32
#    (falls back to AUTH_GITHUB_SECRET if unset)
AUTH_SECRET=

# 3) Email login links, sent through Resend (https://resend.com).
#    EMAIL_FROM must be a sender on a domain verified in Resend (SPF, DKIM, DMARC).
#    Without RESEND_API_KEY, local dev prints the link in the server console;
#    production cannot send and nobody can log in.
RESEND_API_KEY=
EMAIL_FROM=Rows <noreply@rows.so>

# 4) GitHub OAuth App → https://github.com/settings/developers
#    Not used to sign in any more. Kept for connecting GitHub to an account (MVP-24).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# 5) The two hosts. The site serves the landing, pricing and public profiles;
#    the app serves sign-in, onboarding and the dashboard. Both domains point at
#    this same Vercel project. Locally, set only NEXT_PUBLIC_APP_URL to
#    http://localhost:3000 and everything is served from one origin.
NEXT_PUBLIC_SITE_URL=https://rows.so
NEXT_PUBLIC_APP_URL=https://app.rows.so

# 6) Claude API key for AI features (project cards, summary, resume import, CV assistant).
#    Optional: without it, AI buttons are hidden and everything can be written by hand.
ANTHROPIC_API_KEY=
